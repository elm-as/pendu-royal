#:import rgba pendu.ui.widgets.rgba
#:import shade pendu.ui.widgets.shade
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import img pendu.config.img
#:import FadeTransition kivy.uix.screenmanager.FadeTransition

# ============================================================== Bases
<Label>:
    font_name: "Body"

<BaseScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
            texture: app.bg_texture

<Heading@Label>:
    font_name: "Title"
    color: rgba("gold")
    font_size: sp(26)
    size_hint_y: None
    height: self.texture_size[1] + dp(6)

<Muted@Label>:
    color: rgba("muted")
    font_size: sp(15)
    text_size: self.width, None
    size_hint_y: None
    height: self.texture_size[1]
    halign: "center"

<RoundButton>:
    font_size: sp(18)
    bold: True
    color: self.fg
    disabled_color: self.fg[:3] + [0.45]
    halign: "center"
    valign: "middle"
    text_size: self.size
    canvas.before:
        PushMatrix
        Scale:
            origin: self.center
            x: self.scale
            y: self.scale
        Color:
            rgba: 0, 0, 0, 0.35
        RoundedRectangle:
            pos: self.x, self.y - dp(3)
            size: self.size
            radius: [self.radius]
        Color:
            rgba: shade(self.bg, 0.8 if self.state == "down" else 1.0) if not self.disabled else shade(self.bg, 0.55)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius]
        Color:
            rgba: 1, 1, 1, 0.12
        RoundedRectangle:
            pos: self.x + dp(2), self.center_y
            size: self.width - dp(4), self.height / 2 - dp(2)
            radius: [self.radius - dp(2), self.radius - dp(2), dp(4), dp(4)]
    canvas.after:
        PopMatrix

<BackButton@RoundButton>:
    text: "‹"
    font_size: sp(30)
    size_hint: None, None
    size: dp(46), dp(46)
    bg: rgba("panel_light")
    radius: dp(23)
    on_release: app.root.current_screen.on_back()

<Panel>:
    padding: dp(12)
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: self.border
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius]
        Color:
            rgba: self.bg
        RoundedRectangle:
            pos: self.x + dp(2), self.y + dp(2)
            size: self.width - dp(4), self.height - dp(4)
            radius: [self.radius - dp(2)]

<PointsChip@Label>:
    size_hint: None, None
    size: self.texture_size[0] + dp(24), dp(34)
    color: rgba("ink")
    bold: True
    font_size: sp(16)
    canvas.before:
        Color:
            rgba: rgba("gold")
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(17)]

<Toast>:
    font_size: sp(17)
    bold: True
    opacity: 0
    halign: "center"
    text_size: self.width - dp(20), None
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.6 * self.opacity
        RoundedRectangle:
            pos: self.center_x - self.texture_size[0] / 2 - dp(12), self.center_y - self.texture_size[1] / 2 - dp(6)
            size: self.texture_size[0] + dp(24), self.texture_size[1] + dp(12)
            radius: [dp(12)]

# ============================================================== Composants du jeu
<LetterTile>:
    text: self.letter.upper() if self.shown else ""
    font_size: min(self.height * 0.62, self.width * 0.8)
    bold: True
    color: rgba("danger") if self.state == "missed" else rgba("ink")
    canvas.before:
        PushMatrix
        Scale:
            origin: self.center
            x: self.flip
            y: 1
        Color:
            rgba: (rgba("gold") if self.state == "fresh" else rgba("parchment")) if self.shown else rgba("panel_light")
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: rgba("gold", 0.9) if not self.shown else (0, 0, 0, 0)
        Rectangle:
            pos: self.x + self.width * 0.2, self.y + dp(5)
            size: self.width * 0.6, dp(3)
    canvas.after:
        PopMatrix

<KeyButton>:
    font_size: min(self.width, self.height) * 0.6
    radius: dp(9)
    bg: {"hit": rgba("hit"), "miss": rgba("miss"), "selected": rgba("gold")}.get(self.status, rgba("parchment"))
    fg: rgba("text") if self.status in ("hit", "miss") else rgba("ink")

<Feather>:
    canvas.before:
        PushMatrix
        Translate:
            y: -self.drop
        Rotate:
            angle: self.angle
            origin: self.center
    canvas.after:
        PopMatrix

# ============================================================== Accueil
<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(18), dp(14)
        spacing: dp(10)
        BoxLayout:
            size_hint_y: None
            height: dp(46)
            RoundButton:
                size_hint: None, None
                size: dp(46), dp(46)
                radius: dp(23)
                bg: rgba("panel_light")
                text: ""
                on_release: app.go("settings", "left")
                Image:
                    source: img("parameter")
                    center: self.parent.center
                    size: dp(30), dp(30)
            Widget:
            PointsChip:
                text: root.points_text
                pos_hint: {"center_y": 0.5}
        Label:
            text: "PENDU"
            font_name: "Title"
            font_size: sp(56)
            color: rgba("gold")
            size_hint_y: None
            height: dp(70)
        Label:
            text: "R O Y A L"
            font_name: "Title"
            font_size: sp(24)
            color: rgba("parchment")
            size_hint_y: None
            height: dp(30)
        Image:
            source: img("pendu_hero")
            fit_mode: "contain"
            size_hint_y: 1
        RoundButton:
            text: "JOUER"
            font_name: "Title"
            font_size: sp(28)
            size_hint_y: None
            height: dp(70)
            bg: rgba("gold")
            fg: rgba("ink")
            on_release: root.play()
        RoundButton:
            text: "DÉFI DU JOUR\n[size=14sp][color=#F3E3C3]" + root.daily_text + "[/color][/size]"
            markup: True
            size_hint_y: None
            height: dp(66)
            bg: rgba("brand")
            on_release: root.daily()
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            spacing: dp(10)
            RoundButton:
                text: "SUCCÈS"
                bg: rgba("panel_light")
                on_release: app.go("achievements", "left")
            RoundButton:
                text: "STATISTIQUES"
                bg: rgba("panel_light")
                on_release: app.go("stats", "left")
    Toast:
        id: toast
        size_hint: 1, None
        height: dp(40)
        y: dp(150)

# ============================================================== Choix du mode
<ScreenHeader@BoxLayout>:
    title: ""
    size_hint_y: None
    height: dp(54)
    spacing: dp(10)
    BackButton:
        pos_hint: {"center_y": 0.5}
    Label:
        text: root.title
        font_name: "Title"
        font_size: sp(24)
        color: rgba("gold")
        halign: "left"
        valign: "middle"
        text_size: self.size

<ModeCard>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: dp(16), dp(14)
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: self.accent
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
        Color:
            rgba: rgba("panel")
        RoundedRectangle:
            pos: self.x + dp(6), self.y + dp(2)
            size: self.width - dp(8), self.height - dp(4)
            radius: [dp(16)]
    Label:
        text: root.title
        font_name: "Title"
        font_size: sp(22)
        color: root.accent
        size_hint_y: None
        height: dp(32)
        text_size: self.width, None
    Label:
        text: root.tagline
        color: rgba("text")
        font_size: sp(15)
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]
    Label:
        text: root.record
        color: rgba("muted")
        font_size: sp(14)
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]
    BoxLayout:
        size_hint_y: None
        height: dp(42) if root.show_levels else 0
        opacity: 1 if root.show_levels else 0
        disabled: not root.show_levels
        spacing: dp(8)
        RoundButton:
            text: root.level_label("noob")
            bg: root.level_color("noob") if root.level == "noob" else rgba("panel_light")
            fg: rgba("ink") if root.level == "noob" else rgba("text")
            on_release: root.level = "noob"
        RoundButton:
            text: root.level_label("medium")
            bg: root.level_color("medium") if root.level == "medium" else rgba("panel_light")
            fg: rgba("ink") if root.level == "medium" else rgba("text")
            on_release: root.level = "medium"
        RoundButton:
            text: root.level_label("hard")
            bg: root.level_color("hard") if root.level == "hard" else rgba("panel_light")
            fg: rgba("ink") if root.level == "hard" else rgba("text")
            on_release: root.level = "hard"
    RoundButton:
        text: "JOUER"
        size_hint_y: None
        height: dp(50)
        bg: root.accent
        fg: rgba("ink")
        on_release: root.play()

<ModesScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16), dp(14)
        spacing: dp(12)
        ScreenHeader:
            title: "Choisis ton défi"
        ScrollView:
            do_scroll_x: False
            bar_width: dp(4)
            BoxLayout:
                id: cards
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(14)
                padding: 0, 0, 0, dp(10)

# ============================================================== Partie
<GameScreen>:
    FloatLayout:
        BoxLayout:
            orientation: "vertical"
            padding: dp(12), dp(10), dp(12), dp(8)
            spacing: dp(6)

            # --- Barre du haut
            BoxLayout:
                size_hint_y: None
                height: dp(50)
                spacing: dp(10)
                BackButton:
                    text: "×"
                    pos_hint: {"center_y": 0.5}
                BoxLayout:
                    orientation: "vertical"
                    Label:
                        text: root.title
                        color: root.level_color
                        bold: True
                        font_size: sp(18)
                        halign: "left"
                        valign: "bottom"
                        text_size: self.size
                        shorten: True
                    Label:
                        text: root.subtitle
                        color: rgba("muted")
                        font_size: sp(14)
                        halign: "left"
                        valign: "top"
                        text_size: self.size
                        shorten: True
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: None
                    width: dp(100)
                    PointsChip:
                        text: root.points_text
                        pos_hint: {"right": 1}
                    Label:
                        text: root.score_text
                        color: rgba("gold")
                        font_size: sp(14)
                        halign: "right"
                        text_size: self.size

            # --- Potence (grande) + chrono en médaillon
            FloatLayout:
                size_hint_y: 0.40
                Gallows:
                    id: gallows
                    size_hint: 0.8, 1
                    pos_hint: {"x": -0.04, "y": 0}
                TimerRing:
                    id: timer
                    size_hint: None, None
                    size: [min(self.parent.width * 0.34, self.parent.height * 0.62)] * 2
                    pos_hint: {"right": 1, "top": 1}
                    opacity: 0 if (not root.chrono and root.timer_text == "") else 1
                    Label:
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        text: root.timer_text
                        bold: True
                        font_size: self.parent.height * (0.26 if root.chrono else 0.36)
                        color: rgba("danger") if self.parent.danger else rgba("text")
                Label:
                    text: root.combo_text
                    color: rgba("gold")
                    bold: True
                    font_size: sp(18)
                    size_hint: 0.34, None
                    height: dp(26)
                    pos_hint: {"right": 1, "y": 0.12}

            # --- Plumes
            FeatherBar:
                id: feathers
                size_hint_y: None
                height: 0 if root.unlimited else dp(40)
                opacity: 0 if root.unlimited else 1
                spacing: dp(2)

            # --- Mot
            WordBoard:
                id: board
                size_hint_y: 0.11

            Label:
                text: root.hint_text
                color: rgba("parchment")
                italic: True
                font_size: sp(15)
                text_size: self.width, None
                halign: "center"
                size_hint_y: None
                height: min(self.texture_size[1], dp(64)) if root.hint_text else dp(4)
                shorten: False

            # --- Actions
            BoxLayout:
                size_hint_y: None
                height: dp(46)
                spacing: dp(8)
                RoundButton:
                    text: "Indice" if root.hints_enabled else "Sans indice"
                    bg: rgba("bonus") if root.hints_enabled and not root.hints_locked else rgba("miss")
                    font_size: sp(16)
                    on_release: root.open_hints()
                RoundButton:
                    text: "Mot entier"
                    bg: rgba("brand")
                    font_size: sp(16)
                    on_release: root.open_word_guess()
                RoundButton:
                    text: "Passer -10 s"
                    bg: rgba("panel_light")
                    font_size: sp(15)
                    size_hint_x: 1 if root.chrono else 0.001
                    opacity: 1 if root.chrono else 0
                    disabled: not root.chrono
                    on_release: root.skip_word()

            Keyboard:
                id: keyboard
                size_hint_y: 0.34

        # --- Bandeau d'événement (par-dessus la potence)
        Panel:
            orientation: "horizontal"
            size_hint: 0.94, None
            height: dp(104)
            x: root.width * (0.03 + root.banner_x)
            top: root.height - dp(70)
            opacity: 1 if root.event_visible else 0
            bg: rgba("bg_bottom", 0.96)
            border: root.event_color
            Image:
                source: root.event_image
                size_hint_x: None
                width: self.height
                fit_mode: "contain"
            BoxLayout:
                orientation: "vertical"
                spacing: dp(2)
                Label:
                    text: root.event_name
                    color: root.event_color
                    font_name: "Title"
                    font_size: sp(18)
                    halign: "left"
                    text_size: self.size
                    size_hint_y: None
                    height: dp(26)
                Label:
                    text: root.event_desc
                    color: rgba("text")
                    font_size: sp(14)
                    halign: "left"
                    valign: "top"
                    text_size: self.size
                Widget:
                    size_hint_y: None
                    height: dp(5)
                    canvas:
                        Color:
                            rgba: rgba("border")
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(2)]
                        Color:
                            rgba: root.event_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.width * root.event_progress, self.height
                            radius: [dp(2)]

        Toast:
            id: toast
            size_hint: 1, None
            height: dp(40)
            y: root.height * 0.40

<HintOption>:
    size_hint_y: None
    height: dp(64)
    spacing: dp(10)
    BoxLayout:
        orientation: "vertical"
        Label:
            text: root.label
            bold: True
            font_size: sp(17)
            color: rgba("text") if root.enabled else rgba("muted")
            halign: "left"
            text_size: self.size
        Label:
            text: root.description
            font_size: sp(13)
            color: rgba("muted")
            halign: "left"
            valign: "top"
            text_size: self.size
    RoundButton:
        size_hint: None, None
        size: dp(92), dp(44)
        pos_hint: {"center_y": 0.5}
        text: f"{int(root.cost)} pts"
        bg: rgba("gold")
        fg: rgba("ink")
        disabled: not root.enabled
        sound: ""
        on_release: root.modal.choose(root.kind)

<HintModal>:
    size_hint: 0.92, None
    height: box.minimum_height
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.55
    Panel:
        id: box
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: dp(16)
        Heading:
            text: "Indices"
        Label:
            id: wallet
            color: rgba("gold")
            size_hint_y: None
            height: dp(24)
        BoxLayout:
            id: options
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(6)
        RoundButton:
            text: "Fermer"
            size_hint_y: None
            height: dp(44)
            bg: rgba("panel_light")
            on_release: root.dismiss()

<WordGuessModal>:
    size_hint: 0.92, None
    height: dp(250)
    pos_hint: {"top": 0.95}
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.55
    Panel:
        orientation: "vertical"
        padding: dp(16)
        Heading:
            text: "Le mot entier"
        Muted:
            text: "Juste : gros bonus. Faux : -2 plumes. Le chrono tourne !"
        TextInput:
            id: entry
            multiline: False
            size_hint_y: None
            height: dp(52)
            font_size: sp(24)
            font_name: "Body"
            halign: "center"
            padding: dp(10), dp(10)
            background_normal: ""
            background_active: ""
            background_color: rgba("parchment")
            foreground_color: rgba("ink")
            cursor_color: rgba("ink")
            on_text_validate: root.submit(self.text)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(10)
            RoundButton:
                text: "Annuler"
                bg: rgba("panel_light")
                on_release: root.dismiss()
            RoundButton:
                text: "Proposer"
                bg: rgba("gold")
                fg: rgba("ink")
                on_release: root.submit(entry.text)

<ConfirmModal>:
    size_hint: 0.86, None
    height: box.minimum_height
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.6
    auto_dismiss: True
    Panel:
        id: box
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: dp(18)
        spacing: dp(12)
        Heading:
            text: root.title
        Muted:
            text: root.message
            color: rgba("text")
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(10)
            RoundButton:
                text: root.no_text
                bg: rgba("panel_light")
                on_release: root.answer(False)
            RoundButton:
                text: root.yes_text
                bg: rgba("danger")
                on_release: root.answer(True)

# ============================================================== Résultats
<ScoreLine>:
    size_hint_y: None
    height: dp(24)
    Label:
        text: root.label
        color: rgba("text")
        font_size: sp(15)
        halign: "left"
        text_size: self.size
    Label:
        text: root.value
        color: rgba("gold") if root.positive else rgba("danger")
        bold: True
        font_size: sp(15)
        halign: "right"
        text_size: self.size
        size_hint_x: 0.35

<ResultScreen>:
    FloatLayout:
        BoxLayout:
            orientation: "vertical"
            padding: dp(16), dp(12)
            spacing: dp(8)
            FloatLayout:
                size_hint_y: 0.3
                Image:
                    source: root.header_image
                    fit_mode: "contain"
                    size_hint: 1, 1
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                Image:
                    source: img("trophy") if root.won else ""
                    opacity: 1 if root.won else 0
                    fit_mode: "contain"
                    size_hint: 0.5, 0.5
                    pos_hint: {"center_x": 0.5, "center_y": 0.45}
            Label:
                text: root.title
                font_name: "Title"
                font_size: sp(30)
                color: rgba("gold") if root.won else rgba("danger")
                size_hint_y: None
                height: dp(40)
            Label:
                text: root.subtitle
                color: rgba("muted")
                font_size: sp(15)
                size_hint_y: None
                height: dp(20)
            WordBoard:
                id: board
                size_hint_y: 0.1
            Panel:
                orientation: "vertical"
                size_hint_y: None
                height: dp(150)
                bg: rgba("parchment")
                border: rgba("parchment_dark")
                on_touch_down: root.skip_typing() if self.collide_point(*args[1].pos) else None
                ScrollView:
                    do_scroll_x: False
                    Label:
                        id: definition_label
                        color: rgba("ink")
                        font_size: sp(16)
                        text_size: self.width, None
                        size_hint_y: None
                        height: max(self.texture_size[1], dp(20))
            BoxLayout:
                id: lines_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
            BoxLayout:
                size_hint_y: None
                height: dp(28)
                Label:
                    text: "TOTAL"
                    font_name: "Title"
                    color: rgba("text")
                    halign: "left"
                    text_size: self.size
                Label:
                    text: root.total_text
                    bold: True
                    font_size: sp(22)
                    color: rgba("gold")
                    halign: "right"
                    text_size: self.size
            Label:
                text: root.points_text
                color: rgba("muted")
                font_size: sp(14)
                size_hint_y: None
                height: dp(18)
            BoxLayout:
                id: ach_box
                size_hint_y: None
                height: dp(92) if root.achievements else 0
                spacing: dp(8)
            Widget:
                size_hint_y: 0.05
            BoxLayout:
                size_hint_y: None
                height: dp(56)
                spacing: dp(10)
                RoundButton:
                    text: "MENU"
                    bg: rgba("panel_light")
                    on_release: app.go("home", "right")
                RoundButton:
                    text: root.primary_text
                    bg: rgba("gold")
                    fg: rgba("ink")
                    on_release: root.primary()
        Toast:
            id: toast
            size_hint: 1, None
            height: dp(40)
            y: dp(80)

<NewAchievement>:
    orientation: "vertical"
    Image:
        source: root.source
        fit_mode: "contain"
    Label:
        text: root.title
        color: rgba("gold")
        font_size: sp(12)
        size_hint_y: None
        height: dp(16)
        text_size: self.width, None
        halign: "center"

# ============================================================== Statistiques
<StatCard>:
    orientation: "vertical"
    padding: dp(10)
    canvas.before:
        Color:
            rgba: rgba("panel")
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
    Label:
        text: root.value
        bold: True
        font_size: sp(28)
        color: rgba("gold")
    Label:
        text: root.label
        font_size: sp(14)
        color: rgba("muted")
        text_size: self.width, None
        halign: "center"

<TabButton@RoundButton>:
    key: ""
    selected: False
    bg: rgba("gold") if self.selected else rgba("panel_light")
    fg: rgba("ink") if self.selected else rgba("text")
    font_size: sp(15)

<StatsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16), dp(14)
        spacing: dp(12)
        ScreenHeader:
            title: "Statistiques"
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(6)
            TabButton:
                text: "Facile"
                selected: root.tab == "noob"
                on_release: root.show_tab("noob")
            TabButton:
                text: "Corsé"
                selected: root.tab == "medium"
                on_release: root.show_tab("medium")
            TabButton:
                text: "Infernal"
                selected: root.tab == "hard"
                on_release: root.show_tab("hard")
            TabButton:
                text: "Modes"
                selected: root.tab == "modes"
                on_release: root.show_tab("modes")
        GridLayout:
            id: grid
            cols: 2
            spacing: dp(10)

# ============================================================== Succès
<AchievementCard>:
    orientation: "vertical"
    padding: dp(6)
    spacing: dp(2)
    canvas.before:
        Color:
            rgba: rgba("panel") if self.unlocked else rgba("panel", 0.5)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
    Image:
        source: root.source
        fit_mode: "contain"
        color: (1, 1, 1, 1) if root.unlocked else (0.25, 0.22, 0.2, 1)
    Label:
        text: root.description
        font_size: sp(12)
        color: rgba("text") if root.unlocked else rgba("muted")
        text_size: self.width, None
        halign: "center"
        size_hint_y: None
        height: self.texture_size[1]
    Label:
        text: root.date_text
        font_size: sp(11)
        color: rgba("gold") if root.unlocked else rgba("muted", 0.6)
        size_hint_y: None
        height: dp(16)

<AchievementsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(14), dp(14)
        spacing: dp(10)
        ScreenHeader:
            title: "Succès  " + root.counter
        GridLayout:
            id: grid
            cols: 3
            spacing: dp(8)

# ============================================================== Paramètres
<SettingRow@BoxLayout>:
    title: ""
    detail: ""
    active: False
    callback: None
    size_hint_y: None
    height: dp(76)
    spacing: dp(12)
    BoxLayout:
        orientation: "vertical"
        Label:
            text: root.title
            bold: True
            font_size: sp(18)
            color: rgba("text")
            halign: "left"
            text_size: self.size
            valign: "bottom"
        Label:
            text: root.detail
            font_size: sp(13)
            color: rgba("muted")
            halign: "left"
            valign: "top"
            text_size: self.size
    RoundButton:
        size_hint: None, None
        size: dp(82), dp(42)
        pos_hint: {"center_y": 0.5}
        radius: dp(21)
        text: "OUI" if root.active else "NON"
        bg: rgba("hit") if root.active else rgba("miss")
        on_release: root.callback() if root.callback else None

<SettingsScreen>:
    FloatLayout:
        BoxLayout:
            orientation: "vertical"
            padding: dp(16), dp(14)
            spacing: dp(10)
            ScreenHeader:
                title: "Paramètres"
            SettingRow:
                title: "Sons"
                detail: "Effets sonores du jeu."
                active: root.sound
                callback: lambda: root.toggle("sound")
            SettingRow:
                title: "Vibrations"
                detail: "Vibre en cas d'erreur (Android)."
                active: root.vibration
                callback: lambda: root.toggle("vibration")
            RoundButton:
                text: "Revoir le tutoriel"
                size_hint_y: None
                height: dp(50)
                bg: rgba("panel_light")
                on_release: root.replay_tutorial()
            RoundButton:
                text: "Réinitialiser les statistiques"
                size_hint_y: None
                height: dp(50)
                bg: rgba("danger")
                on_release: root.reset()
            Widget:
            Muted:
                text: "Polices : Cinzel Decorative et Alegreya Sans (SIL OFL 1.1).\nFréquences des mots : Lexique 3 (CC BY-SA 4.0)."
                font_size: sp(12)
        Toast:
            id: toast
            size_hint: 1, None
            height: dp(40)
            y: dp(90)

# ============================================================== Tutoriel
<TutorialScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(22), dp(18)
        spacing: dp(14)
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            Label:
                text: f"{root.page + 1} / {root.pages}"
                color: rgba("muted")
                halign: "left"
                text_size: self.size
                valign: "middle"
            RoundButton:
                text: "Passer"
                size_hint_x: None
                width: dp(100)
                bg: rgba("panel_light")
                on_release: root.finish()
        Image:
            source: root.picture
            fit_mode: "contain"
            size_hint_y: 0.45
        Heading:
            text: root.heading
            halign: "center"
            text_size: self.width, None
        Label:
            text: root.body
            color: rgba("text")
            font_size: sp(18)
            text_size: self.width, None
            halign: "center"
            valign: "top"
        RoundButton:
            text: "C'est parti !" if root.page + 1 == root.pages else "Suivant"
            size_hint_y: None
            height: dp(56)
            bg: rgba("gold")
            fg: rgba("ink")
            on_release: root.next()
