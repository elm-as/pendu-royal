<KeyBordCraftingLab>:
    canvas.before:
        Color:
            rgb: hex("#FFFFFF")
        Rectangle:
            size: self.size
            pos: self.pos
    CustomTextInput:
        id: note
        size_hint: 0.7, 0.8
        pos_hint: {"center_x":0.5, "center_y":0.5}
        bg_color: hex(root.get_colors()["DEFEATE_SCREEN"]["BACKGROUND"]["BOX"]["COLOR2"])
        multiline: True
        default_value: 0.05
    Button:
        text:'Reset'
        color: 1, 0, 0, 1
        on_release: root.reset_sentence()
        size_hint: 0.08, 0.05
        pos_hint: {"x":0.9, "y":0.9}



<CustomButton>:
    id: self.id
    background_normal: ""
    background_activate: ""
    background_color: 0, 0, 0, 0
    
    canvas.before:
        Color:
            rgb: self.bg_color
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: self.radius

<CustomTextInput>:
    custom_text_input: custom_text_input
    BoxLayout:
        orientation: "horizontal"
        size: self.size
        pos_hint: {"center_x":0.5}
        padding: dp(3)
        canvas.before:
            Color:
                rgb:  self.parent.bg_color
            RoundedRectangle:
                size: self.size
                pos: self.pos
                radius: self.parent.radius
        BoxLayout:
            orientation: "horizontal"
            TextInput:
                id: custom_text_input
                text: ""
                readonly: True
                background_normal: ""
                background_activate: ""
                background_color: 0, 0, 0, 0
                foreground_color: self.parent.parent.parent.text_color
                halign: "center"#self.parent.parent.parent.halign
                valign: "middle"#self.parent.parent.parent.valign
                font_size: min(self.width, self.height) * self.parent.parent.parent.default_value
                bold: True
                multiline: self.parent.parent.parent.multiline

<FeatherFrame>:
    orientation:'vertical'
    canvas.before:
        Color:
            rgb: self.bg_color
        Rectangle:
            size: self.size
            pos: self.pos
            source: self.image_path
