<Manager>:
    id: screen_manager

    welcome_screen: welcome_screen
    level_selecting_screen: level_selecting_screen
    stat_level_selecting: stat_level_selecting
    player_data_screen: player_data_screen
    game_view: game_view
    defeate_screen: defeate_screen

    WelcomeScreen:
        id: welcome_screen
        name: "welcome_screen"
        manager: screen_manager

    LevelSelectingScreen:
        id: level_selecting_screen
        name: "level_selecting_screen"
        manager: screen_manager
    
    StatLevelSelectingScreen:
        id: stat_level_selecting
        name: "stat_level_selecting"
        manager: screen_manager

    PlayerDataScreen:
        id: player_data_screen
        name: "player_data"
        manager: screen_manager

    GameView:
        id: game_view
        name: "game_view"
        manager: screen_manager

    KeyBordCraftingLab:
        id: keyboard_crafting_lab
        name: "keyboard_crafting_lab"
        manager: screen_manager

    DefeateScreen:
        id: defeate_screen
        name: "defeate_screen"
        manager: screen_manager

    VictoryScreen:
        id: victory_screen
        name: "victory_screen"
        manager: screen_manager

    CreateAccountScreen:
        id: create_account_screen
        name: "create_account_screen"
        manager: screen_manager
