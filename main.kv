#: import hex kivy.utils.get_color_from_hex
#: import dp kivy.metrics.dp

<CreateAccountScreen>:
    canvas.before:
        Color:
            rgb: hex(root.get_colors()["CREATE_ACCOUNT_SCREEN"]["BACKGROUND"]["MAIN"])
        Rectangle:
            size: self.size
            pos: self.pos
        

<WelcomeScreen>:
    canvas.before:
        Color:
            rgb: hex(root.get_colors()["WELCOME_SCREEN"]["BACKGROUND"]["MAIN"])
        Rectangle:
            size: self.size
            pos: self.pos
    Label:
        text: "Pendu"
        color: hex(root.get_colors()["WELCOME_SCREEN"]["TEXT"]["MAIN_LABEL"])
        size_hint: 0.7, 0.3
        font_size: min(self.width, self.height) * 0.25
        pos_hint: {"center_x":0.5, "center_y":0.90}

    BoxLayout:
        orientation: "vertical"
        size_hint: 0.75, 0.85
        pos_hint: {"center_x":0.45, "center_y":0.5}
        canvas.before:
            Color:
                rgb: hex(root.get_colors()["WELCOME_SCREEN"]["BACKGROUND"]["MAIN"])
            Rectangle:
                size: self.size
                pos: self.pos
                source: root.get_image_path("welcome_wood.png")
    BoxLayout:
        orientation: "vertical"
        size_hint: 0.45, 0.3
        pos_hint: {"center_x":0.7, "center_y":0.4}
        spacing: 40
        canvas.before:
            Color:
                rgb: hex(root.get_colors()["WELCOME_SCREEN"]["BACKGROUND"]["MAIN"])
            Rectangle:
                size: self.size
                pos: self.pos
        CustomButton:
            id: play_button
            text: "Jouer"
            size_hint: 1, 0.2
            
            bg_color: hex(root.get_colors()["WELCOME_SCREEN"]["BACKGROUND"]["MAIN_BUTTONS"]["ON_PRESS"])
            on_press: self.bg_color=hex(root.get_colors()["WELCOME_SCREEN"]["BACKGROUND"]["MAIN_BUTTONS"]["ON_RELEASE"])
            on_release: self.bg_color=hex(root.get_colors()["WELCOME_SCREEN"]["BACKGROUND"]["MAIN_BUTTONS"]["ON_PRESS"]); root.manager.current= "level_selecting_screen"; root.manager.transition.direction="left"#;root.check_tutorial_started()

        CustomButton:
            id: stat_button
            text: "Statistique"
            size_hint: 1, 0.2
            
            bg_color: hex(root.get_colors()["WELCOME_SCREEN"]["BACKGROUND"]["MAIN_BUTTONS"]["ON_PRESS"])
            on_press: self.bg_color=hex(root.get_colors()["WELCOME_SCREEN"]["BACKGROUND"]["MAIN_BUTTONS"]["ON_RELEASE"])
            on_release: self.bg_color=hex(root.get_colors()["WELCOME_SCREEN"]["BACKGROUND"]["MAIN_BUTTONS"]["ON_PRESS"]); root.manager.current= "stat_level_selecting"; root.manager.transition.direction="left"


        CustomButton:
            id: setting
            text: "Paramettre"
            size_hint: 1, 0.2
            
            bg_color: hex(root.get_colors()["WELCOME_SCREEN"]["BACKGROUND"]["MAIN_BUTTONS"]["ON_PRESS"])
            on_press: self.bg_color=hex(root.get_colors()["WELCOME_SCREEN"]["BACKGROUND"]["MAIN_BUTTONS"]["ON_RELEASE"])
            on_release: self.bg_color=hex(root.get_colors()["WELCOME_SCREEN"]["BACKGROUND"]["MAIN_BUTTONS"]["ON_PRESS"])

<LevelSelectingScreen>:
    canvas.before:
        Color:
            rgb: hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["BACKGROUND"]["MAIN"])
        Rectangle:
            size: self.size
            pos: self.pos
    CustomButton:
        id: exit
        text: "<<<"
        size_hint: 0.08, 0.08
        pos_hint: {"x":0.04, "y":0.88}
        font_size: min(self.width, self.height) * 0.32

        radius: [15]
        bg_color: hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["BACKGROUND"]["EXIT_BUTTON"]["ON_PRESS"])
        on_press: self.bg_color=hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["BACKGROUND"]["EXIT_BUTTON"]["ON_RELEASE"])
        on_release: self.bg_color=hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["BACKGROUND"]["EXIT_BUTTON"]["ON_PRESS"]); root.manager.current= "welcome_screen"; root.manager.transition.direction="right"
    FloatLayout:
        orientation: "vertical"
        size_hint: 1, 0.6
        pos_hint: {"center_x":0.5, "center_y":0.5}
        canvas.before:
            Color:
                rgb: hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["BACKGROUND"]["MAIN"])
            Rectangle:
                size: self.size
                pos: self.pos
                source: root.get_image_path("loggin_frame.png")
        BoxLayout:
            orientation: "vertical"
            size_hint: 0.45, 0.7
            pos_hint: {"center_x":0.46, "center_y":0.5}
            spacing: dp(15)
            padding: [15, 15, 15, 15]
            canvas.before:
                Color:
                    rgb: hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["BACKGROUND"]["MAIN"])#"#BCA77B")
                Rectangle:
                    size: self.size
                    pos: self.pos
            Label:
                text: "DIFFICULTE"
                font_size: min(self.width, self.height) * 0.20
                color: hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["TEXT"]["LABEL1"])
                bold: True
            BoxLayout:
                orientation: "vertical"
                BoxLayout:
                    orientation: "horizontal"
                    Label:
                        text: "Facile"
                        color: hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["TEXT"]["LABEL2"])
                        font_size: min(self.width, self.height) * 0.5
                        bold: True
                    CheckBox:
                        id: check_box1
                        group: "level"
                BoxLayout:
                    orientation: "horizontal"
                    Label:
                        text: "Corcé"
                        color: hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["TEXT"]["LABEL3"])
                        font_size: min(self.width, self.height) * 0.5
                        bold: True
                    CheckBox:
                        id: check_box2
                        group: "level"
                BoxLayout:
                    orientation: "horizontal"
                    Label:
                        text: "Infernal"
                        color: hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["TEXT"]["LABEL4"])
                        font_size: min(self.width, self.height) * 0.5
                        bold: True
                    CheckBox:
                        id: check_box3
                        group: "level"
            CustomButton:
                text: "COMMENCER"
                size_hint: 1, 0.5
                pos_hint: {"center_x":0.5, "center_y":0.5}
                font_size: min(self.width, self.height) * 0.25

                bg_color: hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["BACKGROUND"]["START_BUTTON"]["ON_PRESS"])
                on_press: self.bg_color=hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["BACKGROUND"]["START_BUTTON"]["ON_RELEASE"])
                on_release: self.bg_color=hex(root.get_colors()["LEVEL_SELECTING_SCREEN"]["BACKGROUND"]["START_BUTTON"]["ON_PRESS"]); root.start_game()

<GameView>:

    displayer: displayer
    timer_displayer: timer_displayer
    buttons_container: buttons_container
    canvas.before:
        Color:
            rgb: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["MAIN"])
        Rectangle:
            size: self.size
            pos: self.pos

    FloatLayout:
        orientation: "vertical"
        size_hint: 0.95, 0.45
        pos_hint: {"center_x":0.5, "center_y":0.76}
        canvas.before:
            Color:
                rgb: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["MAIN"])
            Rectangle:
                size: self.size
                pos: self.pos
                source: root.get_image_path("game_info_frame.png")
        Label:
            id: word_len
            text:'0'
            size_hint: 0.3, 0.3
            pos_hint: {"center_x":0.865, "center_y":0.725}
            font_size: min(self.width, self.height) * 0.2

        Label:
            id: level_name
            text:''
            color: hex(root.get_colors()["GAME_VIEW"]["TEXT"]["LEVEL_TEXT"])
            pos_hint: {"x":0.05, "center_y":0.85}
            size_hint: 0.3, 0.3
            font_size: min(self.width, self.height) * 0.15
            bold: True

        BoxLayout:
            orientation: "vertical"
            size_hint: 0.2, 0.4
            pos_hint: {"center_x":0.85, "top":1}
            canvas.before:
                Rectangle:
                    size: self.size
                    pos: self.pos
                    source: root.get_image_path("rope.png")
        BoxLayout:
            id: buttons_container
            orientation: "horizontal"
            size_hint: 0.85, 0.1
            pos_hint: {"center_x":0.5, "center_y":0.5}
            spacing: 5
        BoxLayout:
            id: feathers_container
            orientation:'horizontal'
            size_hint: 0.70, 0.1
            pos_hint: {"center_x":0.43, "center_y":0.70}
            spacing: 5
            FeatherFrame:
                bg_color: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["FEATHERS_FRAME"])
                image_path: root.get_image_path("f1.png")
            FeatherFrame:
                bg_color: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["FEATHERS_FRAME"])
                image_path: root.get_image_path("f2.png")
            FeatherFrame:
                bg_color: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["FEATHERS_FRAME"])
                image_path: root.get_image_path("f3.png")
            FeatherFrame:
                bg_color: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["FEATHERS_FRAME"])
                image_path: root.get_image_path("f4.png")
            FeatherFrame:
                bg_color: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["FEATHERS_FRAME"])
                image_path: root.get_image_path("f5.png")
            FeatherFrame:
                bg_color: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["FEATHERS_FRAME"])
                image_path: root.get_image_path("f6.png")
            FeatherFrame:
                bg_color: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["FEATHERS_FRAME"])
                image_path: root.get_image_path("f7.png")
            FeatherFrame:
                bg_color: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["FEATHERS_FRAME"])
                image_path: root.get_image_path("f8.png")
            FeatherFrame:
                bg_color: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["FEATHERS_FRAME"])
                image_path: root.get_image_path("f8.png")

        CustomTextInput:
            id: displayer
            size_hint: 0.5, 0.15
            pos_hint: {"center_x":0.5, "center_y":0.2}
            bg_color: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["TEXTINPUT"]["ON_PRESS"])
            text_color: hex(root.get_colors()["GAME_VIEW"]["TEXT"]["TEXTINPUT"])
            readonly: True

        CustomButton:
            id: exit
            text: "<<<"
            size_hint: 0.08, 0.1
            pos_hint: {"x":0.05, "center_y":0.2}
            font_size: min(self.width, self.height) * 0.32
    
            radius: [15]
            bg_color: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["EXIT_BUTTON"]["ON_PRESS"])
            on_press: self.bg_color=hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["EXIT_BUTTON"]["ON_RELEASE"])
            on_release: self.bg_color=hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["EXIT_BUTTON"]["ON_PRESS"]); root.number = root.default_number; root.ids.word_len.text = "0"; root.manager.current= "level_selecting_screen"; root.manager.transition.direction="right"; root.stop_timer = True; root.reset(is_reset_displayed_text=True, is_reset_life=True, is_reset_feather_cleaned_index=True, is_reset_letter_checked=True)

        Label:
            id: timer_displayer
            text: str(self.parent.parent.number)
            size_hint: 0.3, 0.3
            pos_hint: {"center_x":0.90, "center_y":0.2}
            font_size: min(self.width, self.height) * 0.2
            #color: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["MAIN"])

    FloatLayout:
        id: event_displayer
        orientation:'horizontal'
        size_hint: 0.95, 0.11
        pos_hint: {"center_x":0.5, "center_y":0.45}
        canvas.before:
            Color:
                rgb: hex(root.get_colors()["GAME_VIEW"]["BACKGROUND"]["MAIN"])
            Rectangle:
                size: self.size
                pos: self.pos
        #Image:
        #    id: event_badge
        #    pos_hint: {"center_x":0.93, "center_y":0.5}
        #    size_hint: 0.35, 1
        #    source: ""

    CustomKeyBoard:
        id: keyboard
        target_input: displayer
        general_target: self.parent
        size_hint: 1, 0.35
        pos_hint: {"center_x":0.5, "center_y":0.2}

<StatLevelSelectingScreen>:
    canvas.before:
        Color:
            rgb: hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["BACKGROUND"]["MAIN"])
