<PlayerDataScreen>:
    canvas.before:
        Color:
            rgb: hex(root.get_colors()["PLAYER_DATA_SCREEN"]["BACKGROUND"]["MAIN"])
        Rectangle:
            size: self.size
            pos: self.pos

    CustomButton:
        id: exit
        text: "<<<"
        size_hint: 0.08, 0.08
        pos_hint: {"x":0.04, "y":0.88}
        font_size: min(self.width, self.height) * 0.32

        radius: [15]
        bg_color: hex(root.get_colors()["PLAYER_DATA_SCREEN"]["BACKGROUND"]["EXIT_BUTTON"]["ON_PRESS"])
        on_press: self.bg_color=hex(root.get_colors()["PLAYER_DATA_SCREEN"]["BACKGROUND"]["EXIT_BUTTON"]["ON_RELEASE"])
