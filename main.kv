        on_release: self.bg_color=hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["BACKGROUND"]["EXIT_BUTTON"]["ON_PRESS"]); root.manager.current= "welcome_screen"; root.manager.transition.direction="right"

    BoxLayout:
        orientation: "vertical"
        size_hint: 0.8, 0.4
        pos_hint: {"center_x":0.5, "center_y":0.5}
        spacing: dp(40)
        CustomButton:
            text: "INFERNAL"
            size_hint: 0.6, 0.2
            pos_hint: {"center_x":0.5, "center_y":0.5}
            color: hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["TEXT"]["MAIN_LABEL"])
            font_size: min(self.width, self.height) * 0.2

            bg_color: hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["BACKGROUND"]["MAIN_BUTTON"]["ON_PRESS"])
            on_press: self.bg_color=hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["BACKGROUND"]["MAIN_BUTTON"]["ON_RELEASE"])
            on_release: self.bg_color=hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["BACKGROUND"]["MAIN_BUTTON"]["ON_PRESS"]); root.update_player_level("hard"); root.manager.current= "player_data"
        CustomButton:
            text: "CORCE"
            size_hint: 0.8, 0.2
            pos_hint: {"center_x":0.5, "center_y":0.5}
            color: hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["TEXT"]["MAIN_LABEL"])
            font_size: min(self.width, self.height) * 0.2

            bg_color: hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["BACKGROUND"]["MAIN_BUTTON"]["ON_PRESS"])
            on_press: self.bg_color=hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["BACKGROUND"]["MAIN_BUTTON"]["ON_RELEASE"])
            on_release: self.bg_color=hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["BACKGROUND"]["MAIN_BUTTON"]["ON_PRESS"]); root.update_player_level("medium"); root.manager.current= "player_data"
        CustomButton:
            text: "FACILE"
            size_hint: 1, 0.2
            pos_hint: {"center_x":0.5, "center_y":0.5}
            color: hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["TEXT"]["MAIN_LABEL"])
            font_size: min(self.width, self.height) * 0.2

            bg_color: hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["BACKGROUND"]["MAIN_BUTTON"]["ON_PRESS"])
            on_press: self.bg_color=hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["BACKGROUND"]["MAIN_BUTTON"]["ON_RELEASE"])
            on_release: self.bg_color=hex(root.get_colors()["STAT_LEVEL_SELECTION_SCREEN"]["BACKGROUND"]["MAIN_BUTTON"]["ON_PRESS"]); root.update_player_level("noob"); root.manager.current= "player_data"

<DefeateScreen>:
    canvas.before:
        Color:
            rgb: hex(root.get_colors()["DEFEATE_SCREEN"]["BACKGROUND"]["MAIN"])
        Rectangle:
            size: self.size
            pos: self.pos
    BoxLayout:
        id: buttons_container2
        orientation: "horizontal"
        size_hint: 0.85, 0.08
        pos_hint: {"center_x":0.5, "center_y":0.93}
        spacing: 5

    BoxLayout:
        orientation:'horizontal'""
        size_hint: 0.85, 0.5
        pos_hint: {"center_x":0.5, "y":0.18}
        spacing: 5
        canvas.before:
            Color:
                rgb: hex(root.get_colors()["DEFEATE_SCREEN"]["BACKGROUND"]["MAIN"])
            Rectangle:
                size: self.size
                pos: self.pos
        BoxLayout:
            orientation:'vertical'
            padding: 2
            canvas.before:
                Color: 
                    rgb: hex(root.get_colors()["DEFEATE_SCREEN"]["BACKGROUND"]["BOX"]["COLOR1"])
                RoundedRectangle:
                    size: self.size
                    pos: self.pos
                    radius: [15]
            CustomTextInput:
                id: defintion_viewer
                size_hint: 1, 1
                pos_hint: {"center_x":0.5, "center_y":0.5}
                bg_color: hex(root.get_colors()["DEFEATE_SCREEN"]["BACKGROUND"]["BOX"]["COLOR2"])
                multiline: True
                default_value: 0.12
        BoxLayout:
            orientation:'vertical'
            padding: 2
            canvas.before:
                Color:
                    rgb: hex(root.get_colors()["DEFEATE_SCREEN"]["BACKGROUND"]["MAIN"])
                Rectangle:
                    size: self.size
                    pos: self.pos
            


    BoxLayout:
        orientation:'horizontal'
        size_hint: 0.8, 0.08
        pos_hint: {"center_x":0.5, "y":0.05}
        spacing: 10
        CustomButton:
            text: "CONTINUER"
            size_hint: 0.7, 1

            font_size: min(self.width, self.height) * 0.3
            bg_color: hex(root.get_colors()["DEFEATE_SCREEN"]["BACKGROUND"]["BUTTONS"]["ON_PRESS"])
            on_press: self.bg_color=hex(root.get_colors()["DEFEATE_SCREEN"]["BACKGROUND"]["BUTTONS"]["ON_RELEASE"])
            on_release: self.bg_color=hex(root.get_colors()["DEFEATE_SCREEN"]["BACKGROUND"]["BUTTONS"]["ON_PRESS"])
            bold: True
        CustomButton:
            text: "X"
            size_hint: 0.3, 1

            font_size: min(self.width, self.height) * 0.3
            bg_color: hex(root.get_colors()["DEFEATE_SCREEN"]["BACKGROUND"]["BUTTONS"]["ON_PRESS"])
            on_press: self.bg_color=hex(root.get_colors()["DEFEATE_SCREEN"]["BACKGROUND"]["BUTTONS"]["ON_RELEASE"])
            on_release: self.bg_color=hex(root.get_colors()["DEFEATE_SCREEN"]["BACKGROUND"]["BUTTONS"]["ON_PRESS"]); root.manager.current= "welcome_screen"
            bold: True

