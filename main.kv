    id: keyboard
    canvas.before:
        Color:
            rgb: hex(self.bg_color)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: self.radius
    BoxLayout:
        orientation: "vertical"
        size_hint: 0.95, 0.95
        pos_hint: {"center_x": 0.5, "center_y":0.5}
        spacing: 5
        BoxLayout:
            id: lin1
            orientation: "horizontal"
            spacing: 5
            pos_hint: {"center_x":0.5, "center_y":0.5}
            size_hint: 1, 1
            CustomButton:
                id: a0_button
                text: "à"

                font_size: min(self.width, self.height) * 0.8
                radius: [25]
                bg_color: hex(root.get_colors()["CUSTOM_KEYBOARD"]["BACKGROUND"]["BUTTONS"]["ON_PRESS"])
                on_press: self.bg_color=hex(root.get_colors()["CUSTOM_KEYBOARD"]["BACKGROUND"]["BUTTONS"]["ON_RELEASE"])
                on_release: self.bg_color=hex(root.get_colors()["CUSTOM_KEYBOARD"]["BACKGROUND"]["BUTTONS"]["ON_PRESS"]); self.parent.parent.parent.on_key_press(self.text)
